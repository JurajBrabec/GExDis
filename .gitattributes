# Ensure consistent line endings across platforms (Windows checkouts vs
# Linux containers). The devcontainer and production image both use LF.
* text=auto eol=lf

# Explicitly normalize sources/scripts/config.
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Keep binaries out of delta / line-ending normalization.
*.wasm binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
